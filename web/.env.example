# development: local default. mock unless VITE_API_MODE=http.
# demo: browser-only data, with a visible demo banner. Cannot call the real API.
# production: real API only. A production build fails if this is missing or not http.
VITE_APP_INTENT=development
# mock or http. Production requires http. Demo rejects http.
VITE_API_MODE=mock
# Leave empty to use same-origin /api. The Vite dev server proxies that to http://127.0.0.1:8787.
VITE_API_BASE_URL=
