# Copy to server/.env for local development. Never commit server/.env or put a real secret here.
# Values below are placeholders. Replace SESSION_SECRET and IP_HASH_PEPPER before any shared use.

NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/askme.sqlite

# At least 32 characters. Production refuses values that still contain "replace-with".
SESSION_SECRET=replace-with-a-random-string-at-least-32-chars
# Pepper for IP and anti-abuse hashes. Defaults to SESSION_SECRET when empty.
IP_HASH_PEPPER=replace-with-another-random-string-32-chars
# HMAC pepper for asker view links. Defaults to SESSION_SECRET when empty.
# Rotating it invalidates existing view links. Never log the raw token.
VIEW_TOKEN_PEPPER=

# Local HTTP must stay false. Set true behind HTTPS.
COOKIE_SECURE=false
# Comma-separated browser origins allowed to send cookies.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true trusts a reverse proxy on 127.0.0.1 (the local Nginx). It does not trust every forwarded IP.
TRUST_PROXY=false

# Product defaults that are still unconfirmed. Leave public replies off until that decision is made.
PUBLIC_REPLIES_ENABLED=false
AUTO_FLAG_RISK=true

# mock never calls a network. openai calls AI_BASE_URL from this server only.
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
# Hard cap sent to the model as max_tokens. Length presets stay at or below this.
AI_MAX_OUTPUT_TOKENS=1024
# Completed and failed generations count. Aborted requests do not.
AI_DAILY_LIMIT=40
AI_MAX_CONCURRENT=2

SESSION_TTL_DAYS=14
SUBMIT_RATE_LIMIT=5
SUBMIT_RATE_WINDOW_MS=60000
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=900000
AI_RATE_LIMIT=30
AI_RATE_WINDOW_MS=3600000
REPLY_RATE_LIMIT=30
REPLY_RATE_WINDOW_MS=60000
